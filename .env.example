# Copy to .env (which is gitignored) and fill in. NEVER commit the real .env.
# Local development only. Production jobs use a service principal + Databricks
# secret scope (no token on disk) — see docs/warehouse/04-orchestration-quality-governance.md.

# Workspace URL — not a secret.
DATABRICKS_HOST=https://dbc-16b7e00d-e6b0.cloud.databricks.com

# Serverless SQL warehouse HTTP path — not a secret (just an id).
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/5371a1d00cc91d58

# Personal access token — SECRET. Local dev only.
# Prefer `databricks auth login` (OAuth) over a long-lived PAT when possible.
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Default catalog for local runs (use the dev catalog, not prod).
DATABRICKS_CATALOG=nba_dev
